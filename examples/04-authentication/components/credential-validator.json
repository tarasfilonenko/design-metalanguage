{
  "kind": "component-definition",
  "id": "credential-validator",
  "functionality": "Check username and password are present and within configured length limits. Never log raw credentials.",
  "inputs": {
    "username": {
      "type": "string"
    },
    "password": {
      "type": "string"
    }
  },
  "outcomes": {
    "validCredentials": {
      "type": "object"
    },
    "invalidCredentials": {
      "type": "object"
    }
  }
}
